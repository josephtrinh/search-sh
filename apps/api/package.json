{
  "name": "@samplehub/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@samplehub/catalog": "workspace:*",
    "@samplehub/contracts": "workspace:*",
    "better-sqlite3": "12.2.0",
    "bullmq": "5.58.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.1",
    "ioredis": "5.7.0",
    "meilisearch": "0.51.0",
    "multer": "2.0.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "24.3.0",
    "jest": "30.1.1",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }] },
    "testEnvironment": "node"
  }
}
