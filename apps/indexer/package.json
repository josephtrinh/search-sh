{
  "name": "@samplehub/indexer",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "preflight": "tsx src/preflight.ts",
    "qwen:sample": "tsx scripts/qwen-caption-sample.ts",
    "smoke:search": "tsx src/search-smoke.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.879.0",
    "@samplehub/catalog": "workspace:*",
    "@samplehub/contracts": "workspace:*",
    "better-sqlite3": "12.2.0",
    "bullmq": "5.58.5",
    "dotenv": "17.2.1",
    "mysql2": "3.14.4",
    "sharp": "0.34.5",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.0",
    "tsx": "4.20.5"
  }
}
