# Source catalog (read-only account)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=samplehub_search_reader
DATABASE_PASSWORD=change-me
DATABASE_NAME=sec

# S3 source images (read-only credentials) and public display base
