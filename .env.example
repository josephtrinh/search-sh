# Public service addresses
WEB_HOST=0.0.0.0
WEB_PORT=3000
WEB_ALLOWED_ORIGINS=
API_HOST=127.0.0.1
API_PORT=8000
INFERENCE_URL=http://127.0.0.1:8100

# Source catalog (read-only account)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=samplehub_search_reader
DATABASE_PASSWORD=change-me
DATABASE_NAME=sec

# S3 source images (read-only credentials) and public display base
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=change-me
AWS_BUCKET_URL=https://example-bucket.s3.amazonaws.com

# Local infrastructure
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
MEILI_URL=http://127.0.0.1:7700
MEILI_MASTER_KEY=local-development-master-key
MEILI_INDEX_UID=products
STATE_DATABASE_PATH=./data/search-state.sqlite

# SigLIP 2 image and text-to-image embeddings
EMBEDDING_MODEL_ID=google/siglip2-base-patch16-naflex
EMBEDDING_MODEL_REVISION=b53b807d3a2d5e2b3911292f2d69e5341cdc064c
EMBEDDING_DIMENSIONS=768
SIGLIP_MAX_NUM_PATCHES=576

# DINOv2 alternative image embeddings
DINOV2_MODEL_ID=facebook/dinov2-base
DINOV2_MODEL_REVISION=f9e44c814b77203eaa57a6bdbbd535f21ede1415
DINOV2_DIMENSIONS=768
DINOV2_IMAGE_SIZE=392
DINOV2_POOLING=cls_patch_mean

# Gated DINOv3 ViT-B/16 local archive and image embeddings
DINOV3_MODEL_ID=facebook/dinov3-vitb16-pretrain-lvd1689m
DINOV3_MODEL_ARCHIVE=./temp/facebookdinov3-vitb16-pretrain-lvd1689m-transformers-default-v1.tar.gz
DINOV3_MODEL_DIR=./temp/dinov3-vitb16-pretrain-lvd1689m
DINOV3_ARCHIVE_SHA256=037a1f688847bedfe533bc1c44b336160d56306c91ad008498c93659dbe85fe0
DINOV3_DIMENSIONS=768
DINOV3_IMAGE_SIZE=384
DINOV3_POOLING=cls_patch_mean

# Multilingual E5 text retrieval
TEXT_EMBEDDING_MODEL_ID=intfloat/multilingual-e5-base
TEXT_EMBEDDING_MODEL_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
TEXT_EMBEDDING_DIMENSIONS=768

# Florence 2 generated visual captions (stored only in the local search system)
CAPTION_MODEL_ID=microsoft/Florence-2-base-ft
CAPTION_MODEL_REVISION=f6c1a25888ffc1d945ee8a1a77ac833c7303d46e
CAPTION_TASK=<MORE_DETAILED_CAPTION>
CAPTION_MAX_NEW_TOKENS=200
CAPTION_NUM_BEAMS=3
CAPTION_INDEX_PROVIDER=florence

# Qwen 3.5 caption alternative served by local llama-server
QWEN_CAPTION_URL=http://127.0.0.1:8200
QWEN_CAPTION_MODEL_ID=unsloth/Qwen3.5-0.8B-GGUF:Q4_K_S
QWEN_CAPTION_MODEL_SHA256=5f7ccfa6e9df0d9ebbaff9ee095b18202bec1e0ac313ca688d2c57c9c80a6bc9
QWEN_CAPTION_MMPROJ_SHA256=56e4c6cfe73b0c82e3e82bc518d7591997e61d81f723fc41a586f4fa69ea2453
QWEN_CAPTION_PROMPT_PATH=./services/inference/app/prompts/qwen-material-caption-v1.txt
QWEN_CAPTION_PROMPT_VERSION=qwen-material-caption-v1
QWEN_CAPTION_PROMPT_SHA256=ca52f42df1545616283043810a8fa57f4cca7dabca957ec730ad63c68edb76db
QWEN_CAPTION_MAX_TOKENS=160
QWEN_CAPTION_TIMEOUT_SECONDS=120
QWEN_CAPTION_SEED=42
MAX_QWEN_CAPTION_BATCH=1
QWEN_CONTEXT_SIZE=8192
QWEN_IMAGE_MAX_TOKENS=4096

# Model scheduling and device selection: auto, mps, or cpu
INFERENCE_BACKEND=auto
SIGLIP_BACKEND=auto
DINOV2_BACKEND=auto
DINOV3_BACKEND=auto
TEXT_EMBEDDING_BACKEND=auto
CAPTION_BACKEND=auto
MAX_TEXT_BATCH=32
MAX_IMAGE_BATCH=8
MAX_CAPTION_BATCH=2

# Indexer-owned image selection. Captioning always uses only the representative image.
IMAGE_EMBEDDING_MODE=thumbnail

# Oversized catalog-image normalization. Normal images pass through unchanged.
CATALOG_IMAGE_NORMALIZE_THRESHOLD_PIXELS=25000000
CATALOG_IMAGE_MAX_SOURCE_PIXELS=150000000
CATALOG_IMAGE_MAX_SOURCE_BYTES=52428800
CATALOG_IMAGE_MAX_EDGE=4096
CATALOG_IMAGE_MAX_OUTPUT_BYTES=9437184

# Product-level visual coverage gates (products without selected images are excluded).
STABLE_VISUAL_COVERAGE_MIN=0.95
PREVIEW_VISUAL_COVERAGE_MIN=0.90
